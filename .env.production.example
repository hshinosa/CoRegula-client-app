# Kolabri Client App - Production Environment
# Copy to .env.production and update values

APP_NAME=Kolabri
APP_ENV=production
APP_KEY=base64:whSTEms2vPLTKNAu+t6LJ+p8w1qHUb93jl9/VKJhGuA=
APP_DEBUG=false
APP_URL=https://kolabri.jmola.my.id

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Database
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=kolabri-db
DB_SCHEMA=app
DB_USERNAME=postgres
DB_PASSWORD=your-strong-password

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

# Mail (optional - configure if needed)
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"

# Kolabri API Configuration
API_BASE_URL=http://core-api:3000
CORE_API_INTERNAL_SECRET=change-this-to-strong-secret-in-production
API_TIMEOUT=30

AI_ENGINE_URL=http://ai-engine:8001
SOCKET_URL=http://core-api:3000

# PHP-FPM
PHP_FPM_PM=static
PHP_FPM_MAX_CHILDREN=5
